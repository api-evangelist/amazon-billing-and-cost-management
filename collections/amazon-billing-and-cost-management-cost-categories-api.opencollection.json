        {
          "info": {
            "name": "List Cost Category Definitions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://budgets.amazonaws.com/ListCostCategoryDefinitions",
            "body": {
              "type": "json",
              "data": "{}"
